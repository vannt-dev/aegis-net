#!/bin/sh
echo "🔍 [PRE-COMMIT HOOK] Enforcing code standards & quality..."

export PATH="$PATH:/c/flutter/bin:/c/src/flutter/bin"

if command -v dart >/dev/null 2>&1; then
  echo "1/3 Checking Dart Code Formatting (dart format)..."
  dart format --set-exit-if-changed . >/dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ Code formatting issues found! Run 'dart format .' to format your code before committing."
    exit 1
  fi
  echo "  ✓ Dart code formatting OK"
fi

if command -v flutter >/dev/null 2>&1; then
  echo "2/3 Running Static Code Analysis (flutter analyze)..."
  flutter analyze --no-fatal-infos --no-fatal-warnings
  if [ $? -ne 0 ]; then
    echo "❌ Flutter analyze errors found. Please fix all errors before committing."
    exit 1
  fi
  echo "  ✓ Static code analysis OK"
fi

if command -v cargo >/dev/null 2>&1; then
  echo "3/3 Checking Rust Core Compilation (cargo check)..."
  cargo check --manifest-path rust/aegis_core/Cargo.toml
  if [ $? -ne 0 ]; then
    echo "❌ Rust compilation check failed."
    exit 1
  fi
  echo "  ✓ Rust compilation OK"
fi

echo "✅ [PRE-COMMIT HOOK] All pre-commit checks passed!"
exit 0
