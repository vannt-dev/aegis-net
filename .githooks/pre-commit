#!/bin/sh
echo "🔍 [PRE-COMMIT HOOK] Checking code quality..."

export PATH="$PATH:/c/flutter/bin:/c/src/flutter/bin"

if command -v flutter >/dev/null 2>&1; then
  echo "1/2 Running Flutter analyze..."
  flutter analyze --no-fatal-infos --no-fatal-warnings
  if [ $? -ne 0 ]; then
    echo "❌ Flutter analyze errors found. Please fix errors before committing."
    exit 1
  fi
else
  echo "1/2 [SKIP] Flutter CLI not found in Git shell PATH."
fi

if command -v cargo >/dev/null 2>&1; then
  echo "2/2 Checking Rust Core Crate..."
  cargo check --manifest-path rust/aegis_core/Cargo.toml
  if [ $? -ne 0 ]; then
    echo "❌ Rust compilation check failed."
    exit 1
  fi
else
  echo "2/2 [SKIP] Cargo CLI not found in Git shell PATH."
fi

echo "✅ Pre-commit checks completed!"
exit 0
